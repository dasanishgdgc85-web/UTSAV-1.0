{
  "name": "Idea",
  "type": "object",
  "properties": {
    "plan_id": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "estimated_cost": {
      "type": "number"
    },
    "effort": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "liked": {
      "type": "boolean",
      "default": false
    },
    "disliked": {
      "type": "boolean",
      "default": false
    },
    "added": {
      "type": "boolean",
      "default": false
    },
    "safety_note": {
      "type": "string"
    }
  },
  "required": [
    "plan_id",
    "title"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}